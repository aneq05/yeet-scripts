# Self-check project for this repository.

YEET_PROJECT_ROOT="$YEET_ROOT"
YEET_STORE_COMMAND_OUTPUT=false

YEET_BUILD_APP="bash -n bin/yeet lib/core.sh modules/*/module.sh"
YEET_RUN_UT="bin/yeet modules >/dev/null && bin/yeet commit format feat auth add login validation >/dev/null && bin/yeet commit format clean generated coverage artifacts >/dev/null"
YEET_TEST_UT="$YEET_RUN_UT"

YEET_CPD="printf 'Configure a real CPD command in projects/%s.env\n' \"${YEET_PROJECT_NAME:-yeet}\""
YEET_COVERAGE="printf 'No coverage job configured for %s yet\n' \"${YEET_PROJECT_NAME:-yeet}\""
