# Manual C++ demo project bundled with yeet-scripts.

YEET_PROJECT_ROOT="$YEET_ROOT/examples/cpp-calculator"
YEET_STORE_COMMAND_OUTPUT=false

YEET_BUILD_APP="scripts/build.sh"
YEET_RUN_UT="scripts/run-ut.sh"
YEET_TEST_UT="$YEET_RUN_UT"

YEET_CPD="scripts/check-cpd.sh"
YEET_COVERAGE="scripts/coverage.sh"
