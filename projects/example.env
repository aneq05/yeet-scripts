# Copy this file to projects/<project>.env and adapt paths/commands.

YEET_PROJECT_ROOT="$HOME/projects/my-app"
YEET_STORE_COMMAND_OUTPUT=false

YEET_BUILD_APP="cmake --build build"
YEET_RUN_UT="ctest --test-dir build --output-on-failure"
YEET_TEST_UT="$YEET_RUN_UT"

YEET_CPD="npx --yes jscpd ."
YEET_COVERAGE="ctest --test-dir build --output-on-failure && gcovr --xml coverage.xml --html-details coverage.html"
